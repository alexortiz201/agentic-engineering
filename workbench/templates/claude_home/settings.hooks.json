{
  "_comment": "The `hooks` key only. Merge this into ~/.claude/settings.json -- do not replace that file with this one. Every `command` path is absolute because hook commands are not guaranteed to undergo shell expansion; install.sh substitutes __HOME__ with the real home directory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "__HOME__/.claude/hooks/guard_claude_md.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "__HOME__/.claude/hooks/boot_memory.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "__HOME__/.claude/hooks/cleanup_on_stop_phrase.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git *)", "command": "__HOME__/.claude/hooks/cleanup_on_git.sh", "timeout": 15 }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          { "type": "command", "command": "__HOME__/.claude/hooks/reconcile_on_task_done.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
